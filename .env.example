# ------------------------------------------------------------------
# Adam Technical Services — environment variables
# Copy to .env.local and fill in. None are required to build/render;
# the contact + RFQ route handlers degrade gracefully when unset
# (they log the submission and return success) so previews work.
# ------------------------------------------------------------------

# Public canonical origin (no trailing slash). Used for metadata,
# canonicals, sitemap, robots and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://www.adam.qa

# --- Payload CMS (backend / admin at /admin) ---
# PostgreSQL connection string.
DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/adam_cms
# Long random string used to sign/secure Payload sessions & tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Absolute path where uploaded media is stored (a persistent volume on the
# droplet). Defaults to ./media if unset.
PAYLOAD_MEDIA_DIR=/app/media

# --- Email delivery for the contact / RFQ / careers forms ---
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
# Option B: SMTP (used only if RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Where form submissions are delivered.
CONTACT_TO_EMAIL=info@adam.qa
CONTACT_FROM_EMAIL=website@adam.qa
