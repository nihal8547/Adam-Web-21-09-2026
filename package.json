{
  "name": "adam-technical-services",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate website for Adam Technical Services — QCDD-certified fire protection & MEP contractor in Doha, Qatar.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f db",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d --wait",
    "setup": "node scripts/setup-env.mjs && npm run db:up",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.1",
    "@payloadcms/email-nodemailer": "^3.90.1",
    "@payloadcms/next": "^3.90.1",
    "@payloadcms/plugin-seo": "^3.90.1",
    "@payloadcms/richtext-lexical": "^3.90.1",
    "@types/three": "^0.186.0",
    "graphql": "^16.14.2",
    "lenis": "^1.3.26",
    "next": "~15.4.11",
    "payload": "^3.90.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.35.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "~15.4.11",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3"
  }
}
