# Copy to .env on the droplet (next to docker-compose.yml) and fill in.
# docker compose reads this file automatically.

# --- Database (used by both the db and app services) ---
POSTGRES_USER=adam
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=adam_cms

# --- Payload / app ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=https://www.adam.qa

# --- Optional email delivery (forms + password reset) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@adam.qa
