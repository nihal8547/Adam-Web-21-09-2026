# Copy to .env on the droplet (next to docker-compose.yml) and fill in.
# docker compose reads this file automatically.

# --- Database (used by both the db and app services) ---
POSTGRES_USER=adam
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=adam_cms

# --- Payload / app ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=https://www.adam.qa

# --- First admin bootstrap (optional) ---
# If set and no user exists, POST /api/seed creates this admin. Otherwise use
# the "create first user" screen at /admin. Remove after the first deploy.
ADMIN_EMAIL=admin@adam.qa
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Administrator

# --- Optional email delivery (forms + admin password reset) ---
# Resend for the public forms; SMTP powers both the forms and Payload's
# admin emails. Leave SMTP unset to log preview URLs to the console.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@adam.qa
CONTACT_FROM_EMAIL=website@adam.qa
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Adam Technical Services
